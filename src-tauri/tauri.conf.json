{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyJam",
  "version": "0.1.0",
  "identifier": "com.lilypad.jam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyJam",
        "width": 380,
        "height": 640,
        "minWidth": 320,
        "minHeight": 96,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://resources.tidal.com https://i.scdn.co; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attune",
  "version": "0.1.4",
  "identifier": "com.lilypad.attune",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Attune",
        "width": 380,
        "height": 640,
        "minWidth": 380,
        "maxWidth": 380,
        "minHeight": 96,
        "maxHeight": 640,
        "backgroundColor": "#111215",
        "decorations": false,
        "visible": false,
        "skipTaskbar": false,
        "shadow": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://resources.tidal.com https://i.scdn.co https://lh3.googleusercontent.com https://i.ytimg.com https://yt3.ggpht.com https://yt3.googleusercontent.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "attune"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNzAzQ0Q3OEFFMUY0MjIKUldRaTlPR0sxenh3TXRLcXp0R3E3YU5KMmlNUHAwVzlWcUdaSHZkNzFNT0JPY0VqcjVMRGd0NkQK",
      "endpoints": [
        "https://github.com/curlily/Attune/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
